        "name": "Report Influx write errors only",
        "func": "if (msg.error) {\n    node.warn('Influx write transport error: ' + String(msg.error.message || msg.error));\n} else if (!Number.isInteger(msg.statusCode) || msg.statusCode < 200 || msg.statusCode >= 300) {\n    node.warn('Influx write HTTP status ' + String(msg.statusCode));\n}\nreturn null;",
