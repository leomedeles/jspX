        "func": "const p = msg.payload || {};\nconst t = Number.isFinite(p.ts) ? p.ts : Date.now(); // ms\nconst lines = [];\n\nif (Array.isArray(p.buses)) {\n  for (const b of p.buses) {\n    if (b && b.bus_idx != null && b.vm_pu != null) {\n      const tags = [\n        `bus_id=${b.bus_idx}`,\n        `name=${String(b.name).replace(/[,\\s]/g, '_')}`,\n      ]\n      const fields = [\n        `vm_pu=${Number(b.vm_pu)}`,\n        (b.va_degree != null ? [`va_deg=${Number(b.va_degree)}`] : []),\n        (b.p_mw != null ? [`p_mw=${Number(b.p_mw)}`] : []),\n        (b.q_mvar != null ? [`q_mvar=${Number(b.q_mvar)}`] : [])\n      ].join(\",\");\n      if (fields) lines.push(`bus,${tags} ${fields} ${t}`);\n    }\n  }\n}\n\nif (Array.isArray(p.lines)) {\n  for (const l of p.lines) {\n    if (!l || !l.name) continue;\n    const tags = [\n      `line_id=${l.line_idx}`,\n      `name=${String(l.name).replace(/[,\\s]/g, '_')}`,\n      `end=${String(l.end)}`,\n      `from_bus=${String(l.from_bus)}`,\n      `to_bus=${String(l.to_bus)}`,\n    ].join(\",\");\n    const fields = [\n      ...(l.p_mw != null ? [`p_mw=${Number(l.p_mw)}`] : []),\n      ...(l.pl_mw != null ? [`pl_mw=${Number(l.pl_mw)}`] : []),\n      ...(l.q_mvar != null ? [`q_mvar=${Number(l.q_mvar)}`] : []),\n      ...(l.ql_mvar != null ? [`ql_mvar=${Number(l.ql_mvar)}`] : []),\n      ...(l.i_ka != null ? [`i_ka=${Number(l.i_ka)}`] : []),\n      ...(l.vm_pu != null ? [`vm_pu=${Number(l.vm_pu)}`] : []),\n      ...(l.va_degree != null ? [`va_deg=${Number(l.va_degree)}`] : []),\n      ...(l.loading_pct != null ? [`loading_percent=${Number(l.loading_pct)}`] : [])\n    ].join(\",\");\n    if (fields) lines.push(`line,${tags} ${fields} ${t}`);\n  }\n} \n\nif (p.ext_grid && (p.ext_grid.p_mw != null || p.ext_grid.q_mvar != null)) {\n  const fields = [\n    ...(p.ext_grid.p_mw != null ? [`p_mw=${Number(p.ext_grid.p_mw)}`] : []),\n    ...(p.ext_grid.q_mvar != null ? [`q_mvar=${Number(p.ext_grid.q_mvar)}`] : [])\n  ].join(\",\");\n  lines.push(`ext_grid,site=main ${fields} ${t}`);\n}\n\n\nmsg.payload = lines.join(\"\\n\");\n\nreturn msg;",
