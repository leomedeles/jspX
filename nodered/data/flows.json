    {
        "id": "7d88f8edcae91d28",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Telemetry to line protocol",
        "func": "const p = msg.payload || {};\nconst parsedTs = Date.parse(p.ts);\nconst t = Number.isFinite(parsedTs) ? parsedTs : Date.now();\nconst lines = [];\n\nif (Array.isArray(p.buses)) {\n  for (const b of p.buses) {\n    if (b && b.bus_idx != null) {\n      const tags = [\n        `bus_id=${b.bus_idx}`,\n        `name=${String(b.name).replace(/[,\\s]/g, '_')}`,\n      ]\n      const fields = [\n        ...(b.vm_pu != null ? [`vm_pu=${Number(b.vm_pu)}`] : []),\n        ...(b.va_degree != null ? [`va_deg=${Number(b.va_degree)}`] : []),\n        ...(b.p_mw != null ? [`p_mw=${Number(b.p_mw)}`] : []),\n        ...(b.q_mvar != null ? [`q_mvar=${Number(b.q_mvar)}`] : []),\n        `energized=${!!b.energized}`,\n        ...(b.quality != null ? [`quality=${JSON.stringify(b.quality)}`] : [])\n      ].join(\",\");\n      if (fields) lines.push(`bus,${tags} ${fields} ${t}`);\n    }\n  }\n}\n\nif (Array.isArray(p.lines)) {\n  for (const l of p.lines) {\n    if (!l || !l.name) continue;\n    const tags = [\n      `line_id=${l.line_idx}`,\n      `name=${String(l.name).replace(/[,\\s]/g, '_')}`,\n      `end=${String(l.end)}`,\n      `from_bus=${String(l.from_bus)}`,\n      `to_bus=${String(l.to_bus)}`,\n    ].join(\",\");\n    const fields = [\n      ...(l.p_mw != null ? [`p_mw=${Number(l.p_mw)}`] : []),\n      ...(l.pl_mw != null ? [`pl_mw=${Number(l.pl_mw)}`] : []),\n      ...(l.q_mvar != null ? [`q_mvar=${Number(l.q_mvar)}`] : []),\n      ...(l.ql_mvar != null ? [`ql_mvar=${Number(l.ql_mvar)}`] : []),\n      ...(l.i_ka != null ? [`i_ka=${Number(l.i_ka)}`] : []),\n      ...(l.vm_pu != null ? [`vm_pu=${Number(l.vm_pu)}`] : []),\n      ...(l.va_degree != null ? [`va_deg=${Number(l.va_degree)}`] : []),\n      ...(l.loading_percent != null ? [`loading_percent=${Number(l.loading_percent)}`] : []),\n      `energized=${!!l.energized}`,\n      ...(l.quality != null ? [`quality=${JSON.stringify(l.quality)}`] : [])\n    ].join(\",\");\n    if (fields) lines.push(`line,${tags} ${fields} ${t}`);\n  }\n}\n\nif (Array.isArray(p.transformers)) {\n  for (const tr of p.transformers) {\n    if (!tr || tr.transformer_idx == null || !tr.name) continue;\n    const tags = [\n      `transformer_id=${tr.transformer_idx}`,\n      `name=${String(tr.name).replace(/[,\\s]/g, '_')}`,\n      `hv_bus=${String(tr.hv_bus)}`,\n      `lv_bus=${String(tr.lv_bus)}`,\n    ].join(\",\");\n    const fields = [\n      ...(tr.p_hv_mw != null ? [`p_hv_mw=${Number(tr.p_hv_mw)}`] : []),\n      ...(tr.q_hv_mvar != null ? [`q_hv_mvar=${Number(tr.q_hv_mvar)}`] : []),\n      ...(tr.p_lv_mw != null ? [`p_lv_mw=${Number(tr.p_lv_mw)}`] : []),\n      ...(tr.q_lv_mvar != null ? [`q_lv_mvar=${Number(tr.q_lv_mvar)}`] : []),\n      ...(tr.i_hv_ka != null ? [`i_hv_ka=${Number(tr.i_hv_ka)}`] : []),\n      ...(tr.i_lv_ka != null ? [`i_lv_ka=${Number(tr.i_lv_ka)}`] : []),\n      ...(tr.vm_hv_pu != null ? [`vm_hv_pu=${Number(tr.vm_hv_pu)}`] : []),\n      ...(tr.vm_lv_pu != null ? [`vm_lv_pu=${Number(tr.vm_lv_pu)}`] : []),\n      ...(tr.va_hv_degree != null ? [`va_hv_deg=${Number(tr.va_hv_degree)}`] : []),\n      ...(tr.va_lv_degree != null ? [`va_lv_deg=${Number(tr.va_lv_degree)}`] : []),\n      ...(tr.loading_percent != null ? [`loading_percent=${Number(tr.loading_percent)}`] : []),\n      `energized=${!!tr.energized}`,\n      ...(tr.quality != null ? [`quality=${JSON.stringify(tr.quality)}`] : [])\n    ].join(\",\");\n    if (fields) lines.push(`transformer,${tags} ${fields} ${t}`);\n  }\n}\n\nif (p.ext_grid && (p.ext_grid.p_mw != null || p.ext_grid.q_mvar != null)) {\n  const tags = `grid_id=${p.ext_grid.grid_idx},name=${String(p.ext_grid.name).replace(/[,\\s]/g, '_')}`;\n  const fields = [\n    ...(p.ext_grid.p_mw != null ? [`p_mw=${Number(p.ext_grid.p_mw)}`] : []),\n    ...(p.ext_grid.q_mvar != null ? [`q_mvar=${Number(p.ext_grid.q_mvar)}`] : [])\n  ].join(\",\");\n  lines.push(`ext_grid,${tags} ${fields} ${t}`);\n}\n\nmsg.payload = lines.join(\"\\n\");\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
