    {
        "id": "fn_status_to_lp",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Status → line protocol",
        "func": "// Persist only the simulator's authoritative breaker/protection status.\nconst p = msg.payload || {};\nconst timestamp = Date.parse(p.ts);\nconst breaker = String(p.breaker || \"\");\nconst state = String(p.state || \"\").toUpperCase();\nconst knownBreakers = [\"BRK_F1\", \"BRK_R1\"];\n\nif (!Number.isFinite(timestamp)) {\n    node.warn(\"Ignoring breaker status without a valid timestamp\");\n    return null;\n}\nif (!knownBreakers.includes(breaker) ||\n    (state !== \"OPEN\" && state !== \"CLOSED\") ||\n    typeof p.tripped !== \"boolean\" ||\n    typeof p.undervoltage_alarm !== \"boolean\") {\n    node.warn(\"Ignoring malformed authoritative breaker status\");\n    return null;\n}\n\nconst tripReason = p.trip_reason == null ? \"\" : String(p.trip_reason);\nconst fields = [\n    `state=${JSON.stringify(state)}`,\n    `tripped=${p.tripped}`,\n    `undervoltage_alarm=${p.undervoltage_alarm}`,\n    `trip_reason=${JSON.stringify(tripReason)}`\n];\n\nmsg.payload = `breaker_status,breaker=${breaker} ${fields.join(\",\")} ${timestamp}`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 580,
        "wires": [
            [
                "917c308f0b48aa53"
            ]
        ]
    },
