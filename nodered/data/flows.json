    {
        "id": "fn_status_to_lp",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Status → line protocol",
        "func": "// Persist only the simulator's authoritative breaker/protection status.\nconst p = msg.payload || {};\nconst timestamp = Date.parse(p.ts);\nconst state = String(p.state || \"\").toUpperCase();\n\nif (!Number.isFinite(timestamp)) {\n    node.warn(\"Ignoring breaker status without a valid timestamp\");\n    return null;\n}\nif ((state !== \"OPEN\" && state !== \"CLOSED\") ||\n    typeof p.tripped !== \"boolean\" ||\n    typeof p.undervoltage_alarm !== \"boolean\") {\n    node.warn(\"Ignoring malformed authoritative breaker status\");\n    return null;\n}\n\nconst tripReason = p.trip_reason == null ? \"\" : String(p.trip_reason);\nconst fields = [\n    `state=${JSON.stringify(state)}`,\n    `tripped=${p.tripped}`,\n    `undervoltage_alarm=${p.undervoltage_alarm}`,\n    `trip_reason=${JSON.stringify(tripReason)}`\n];\n\nmsg.payload = `breaker_status,breaker=BRK_L1_SOURCE ${fields.join(\",\")} ${timestamp}`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 580,
        "wires": [
            [
                "917c308f0b48aa53"
            ]
        ]
    },
    {
        "id": "fn_cmd_to_lp",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Command → line protocol",
        "func": "// Build LP for commands (OPEN/CLOSE or RESET)\nconst topic = String(msg.topic || '');\nlet action = 'UNKNOWN';\nif (topic.endsWith('/set')) action = String(msg.payload || '').toUpperCase();\nif (topic.endsWith('/reset')) action = 'RESET';\n\nconst closed = action === 'CLOSE' ? 1 : 0;\n\nconst lp = `breaker,source=command action=\"${action}\",closed=${closed}i`;\n\nmsg.payload = lp;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1030,
        "y": 660,
        "wires": [
            [
                "917c308f0b48aa53"
            ]
        ]
    },
