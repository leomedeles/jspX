    {
        "id": "fn_online_text_toast",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "ONLINE/OFFLINE → text + toast on change",
        "func": "let prev = context.get('prev');\nconst online = !!(msg.payload && msg.payload.online);\nconst text = online ? 'ONLINE' : 'OFFLINE';\nconst outText = { payload: text };\nlet outToast = null;\nif (prev !== undefined && prev !== online) {\n    outToast = { topic: 'Plant', payload: online ? 'Plant ONLINE' : 'Plant OFFLINE', position: 'top right', timeout: 3 };\n}\ncontext.set('prev', online);\nreturn [outText, outToast];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
