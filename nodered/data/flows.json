    {
        "id": "fn_ied_event_to_lp",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "IED event → line protocol",
        "func": "const p = msg.payload || {};\nconst timestamp = Date.parse(p.ts);\nconst identity = {BRK_F1: \"IED_F1\", BRK_R1: \"IED_R1\"};\nconst events = [\"PICKUP\", \"TIMING_STARTED\", \"TIMING_CANCELLED\", \"TRIP_REQUEST\",\n    \"OPERATION_REQUEST\", \"POSITION_FEEDBACK\", \"RESET\", \"CLOSE_REJECTED\"];\nif (!Number.isFinite(timestamp) || identity[p.breaker] !== p.ied ||\n    !events.includes(p.event) || typeof p.event_id !== \"string\" ||\n    !/^[a-f0-9]{32}:[1-9][0-9]*$/.test(p.event_id) ||\n    ![\"OPEN\", \"CLOSED\"].includes(p.position) ||\n    typeof p.tripped !== \"boolean\" ||\n    !Number.isFinite(p.scan_monotonic_s)) {\n    node.warn(\"Ignoring malformed IED event\");\n    return null;\n}\nconst tag = value => String(value).replace(/\\\\/g, \"\\\\\\\\\").replace(/([ ,=])/g, \"\\\\$1\");\nconst fields = [\n    `position=${JSON.stringify(p.position)}`,\n    `tripped=${p.tripped}`,\n    `scan_monotonic_s=${p.scan_monotonic_s}`\n];\nif (p.requested_state != null) fields.push(`requested_state=${JSON.stringify(p.requested_state)}`);\nif (p.actual_state != null) fields.push(`actual_state=${JSON.stringify(p.actual_state)}`);\nif (typeof p.success === \"boolean\") fields.push(`success=${p.success}`);\nif (p.cause != null) fields.push(`cause=${JSON.stringify(p.cause)}`);\nmsg.payload = `ied_event,ied=${tag(p.ied)},breaker=${tag(p.breaker)},event=${tag(p.event)},event_id=${tag(p.event_id)} ${fields.join(\",\")} ${timestamp}`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 1030,
        "wires": [
            [
                "917c308f0b48aa53"
            ]
        ]
    },
    {
        "id": "fn_status_display",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Validate and display F1/R1 status",
        "func": "// Outputs: F1 state/latch/reason/UV, R1 state/latch/reason, valid historian status.\nconst offsets = {BRK_F1: 0, BRK_R1: 4};\nconst result = Array(8).fill(null);\nfunction display(breaker, status) {\n    const at = offsets[breaker];\n    const valid = status !== null;\n    result[at] = {payload: valid ? status.state : 'UNKNOWN'};\n    result[at + 1] = {payload: valid ? (status.tripped ? 'TRIPPED' : 'OK') : 'UNKNOWN'};\n    result[at + 2] = {payload: valid ? (status.trip_reason == null ? '-' : status.trip_reason) : 'UNKNOWN'};\n    if (breaker === 'BRK_F1') {\n        result[3] = {payload: valid ? (status.undervoltage_alarm ? 'ALARM' : 'NORMAL') : 'UNKNOWN'};\n    }\n}\nif (msg.topic === 'status/bootstrap') {\n    for (const breaker of Object.keys(offsets)) {\n        if (!context.get('seen_' + breaker)) display(breaker, null);\n    }\n    return result;\n}\nconst breaker = String(msg.topic || '').replace(/^status\\/breaker\\//, '');\nif (!Object.hasOwn(offsets, breaker) || msg.topic !== 'status/breaker/' + breaker) {\n    node.warn('Ignoring status on unexpected topic');\n    return null;\n}\ncontext.set('seen_' + breaker, true);\nlet p;\ntry {\n    p = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (_) {\n    p = null;\n}\nconst valid = p && typeof p === 'object' && !Array.isArray(p) &&\n    p.breaker === breaker && (p.state === 'OPEN' || p.state === 'CLOSED') &&\n    typeof p.tripped === 'boolean' && typeof p.undervoltage_alarm === 'boolean' &&\n    (p.trip_reason === null || typeof p.trip_reason === 'string') &&\n    Number.isFinite(Date.parse(p.ts));\nif (!valid) {\n    node.warn('Ignoring malformed status for ' + breaker);\n    display(breaker, null);\n    return result;\n}\ndisplay(breaker, p);\nresult[7] = {payload: p};\nreturn result;",
        "outputs": 8,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
