        "name": "Mark ONLINE + reset timer",
        "func": "// Every sample resets the five-second timer; presence emits only transitions.\nreturn [{ payload: { online: true } }, msg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
