        "z": "f2a7b9f2d1c64f2a",
        "name": "Toast on TRIPPED rising edge",
        "func": "// Detect false→true transition of payload.tripped\nlet prev = context.get('prev')\nlet curr = !!(msg.payload && msg.payload.tripped)\ncontext.set('prev', curr)\nif (prev === false && curr === true) {\n    return { topic: \"Protection\", payload: \"Breaker TRIPPED (overcurrent)\", position: \"top right\", timeout: 3 }\n}\nreturn null",
