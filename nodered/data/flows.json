    {
        "id": "fn_online_text_toast",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Plant presence transitions",
        "func": "const prev = context.get('prev');\nconst online = msg.payload && msg.payload.online === true;\nif (prev === online) return [null, null];\ncontext.set('prev', online);\nconst outText = { payload: online ? 'ONLINE' : 'OFFLINE' };\nconst outToast = prev === undefined ? null : {\n    topic: 'Plant', payload: online ? 'Plant ONLINE' : 'Plant OFFLINE',\n    position: 'top right', timeout: 3\n};\nreturn [outText, outToast];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 240,
        "wires": [
            [
                "ui_plant_text"
            ],
            [
                "ui_toast_trip"
            ]
        ]
    },
