    {
        "id": "gate_close_if_tripped",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Gate CLOSE while tripped",
        "func": "// Block CLOSE when flow.tripped === true\nconst tripped = flow.get('tripped') === true;\nconst cmd = String(msg.payload || '').toUpperCase();\nconst topic = String(msg.topic || '');\nif (topic === 'cmd/breaker/main/set' && cmd === 'CLOSE' && tripped) {\n    const toast = { topic: 'Protection', payload: 'Reset required (breaker tripped)', position: 'top right', timeout: 3 };\n    const snap = { payload: 'OPEN' }; // send to switch input (decoupled)\n    return [null, toast, snap];\n}\nreturn [msg, null, null];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 720,
        "wires": [
            [
                "mqtt_out_cmd",
                "fn_cmd_to_lp"
            ],
            [
                "ui_toast_trip"
            ],
            [
                "switch_cmd"
            ]
        ]
    },
