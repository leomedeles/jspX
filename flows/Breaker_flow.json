    {
        "id": "fn_status_to_lp",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Status → line protocol",
        "func": "// Build LP: breaker,source=status state_code=0i,tripped=false,state_str=\"OPEN\"\nconst src = \"status\";\nconst st = String((msg.payload && msg.payload.state) || \"\").toUpperCase();\nconst tr = !!(msg.payload && msg.payload.tripped);\nconst code = st === \"CLOSED\" ? 1 : 0;\nconst lp = `breaker,source=${src} state_code=${code}i,tripped=${tr},state_str=\"${st}\"`;\n\nmsg.payload = lp;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 580,
        "wires": [
            [
                "917c308f0b48aa53"
            ]
        ]
    },
    {
        "id": "fn_cmd_to_lp",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "Command → line protocol",
        "func": "// Build LP for commands (OPEN/CLOSE or RESET)\nconst topic = String(msg.topic || '');\nlet action = 'UNKNOWN';\nif (topic.endsWith('/set')) action = String(msg.payload || '').toUpperCase();\nif (topic.endsWith('/reset')) action = 'RESET';\n\nconst closed = action === 'CLOSE' ? 1 : 0;\n\nconst lp = `breaker,source=command action=\"${action}\",closed=${closed}i`;\n\nmsg.payload = lp;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1030,
        "y": 660,
        "wires": [
            [
                "917c308f0b48aa53"
            ]
        ]
    },
