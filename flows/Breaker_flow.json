    {
        "id": "917c308f0b48aa53",
        "type": "function",
        "z": "f2a7b9f2d1c64f2a",
        "name": "→ msg.header to Influxdb",
        "func": "const url = env.get('INFLUXDB_URL')\nconst bucket = env.get('INFLUXDB_BUCKET')\nconst org = env.get('INFLUXDB_ORG')\nconst token = env.get('INFLUXDB_WRITE_TOKEN')\n\nmsg.headers = {\n  Authorization: `Token ${token}`,\n  \"Content-Type\": \"text/plain\"\n};\nmsg.url = `${url}/api/v2/write?org=${org}&bucket=${bucket}&precision=ms`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
