            [
                "pickBuses"
            ]
        ]
    },
    {
        "id": "pickBuses",
        "type": "change",
        "z": "tabPP",
        "name": "payload → buses[]",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "payload.buses",
                "tot": "jsonata"
            }
        ],
        "x": 650,
        "y": 80,
        "wires": [
            [
                "splitBuses"
            ]
        ]
    },
    {
        "id": "splitBuses",
        "type": "split",
        "z": "tabPP",
        "name": "Split buses[]",
        "splt": "\\n",
        "spltType": "str",
        "arraySplt": 1,
        "stream": false,
        "addname": "",
        "x": 860,
        "y": 80,
        "wires": [
            [
                "fanout"
            ]
        ]
    },
    {
        "id": "fanout",
        "type": "function",
        "z": "tabPP",
        "name": "Create 3 metrics per bus",
        "func": "// Input: msg.payload = {bus_idx,name,vm_pu,va_degree,p_mw,q_mvar}\n// Output: 3 messages with topics grid/BUS#/vm_pu etc. and payload numeric\nconst b = msg.payload;\nconst bus = (b.name || `BUS${b.bus_idx}`).replace(/\\s+/g,'');\nconst out = [];\nfunction m(metric, value){\n  return { _msgid: msg._msgid + ':' + metric, topic: `grid/${bus}/${metric}`, payload: Number(value) };\n}\nout.push(m('vm_pu', b.vm_pu));\nout.push(m('p_mw', b.p_mw));\nout.push(m('q_mvar', b.q_mvar));\nreturn [ out ];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1090,
        "y": 80,
        "wires": [
            [
                "switchBus"
            ]
        ]
    },
    {
        "id": "switchBus",
        "type": "switch",
        "z": "tabPP",
        "name": "Route by BUS",
        "property": "topic",
        "propertyType": "msg",
        "rules": [
            {
                "t": "cont",
                "v": "grid/BUS0_SLACK/",
                "vt": "str"
            },
            {
                "t": "cont",
                "v": "grid/BUS1_LOAD/",
                "vt": "str"
            },
            {
                "t": "cont",
                "v": "grid/BUS2_LOAD/",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 3,
        "x": 1330,
        "y": 80,
        "wires": [
            [
                "switchMetricB0"
            ],
            [
                "switchMetricB1"
            ],
            [
                "switchMetricB2"
