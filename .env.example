# Local-development defaults. Change these before exposing the stack remotely.
INFLUXDB_ADMIN_USERNAME=CHANGE_ME
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
INFLUXDB_ADMIN_TOKEN=CHANGE_ME
# The quickstart uses the bootstrap admin token for both clients.
# Use scoped read/write tokens in a non-development deployment.
INFLUXDB_WRITE_TOKEN=CHANGE_ME
INFLUXDB_READ_TOKEN=CHANGE_ME
INFLUXDB_ORG=jspX
INFLUXDB_BUCKET=scada
INFLUXDB_URL=http://influxdb:8086

GRAFANA_ADMIN_USER=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_PUB_TOPIC=telemetry/pandapower

SIM_RATE_HZ=1
